# ─── Database (AWS RDS PostgreSQL or Neon) ───────────────────────────────────
DATABASE_URL="postgresql://username:password@your-host:5432/jkcurryhouse_db"

# ─── AWS Cognito (Phase 2 — Auth) ────────────────────────────────────────────
# After creating your User Pool, create a group called "Admins":
#   Cognito → User Pools → [your pool] → Groups → Create group → name: Admins
# Then add your staff email to that group.
NEXT_PUBLIC_COGNITO_USER_POOL_ID="eu-west-2_XXXXXXXXX"
NEXT_PUBLIC_COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── AWS (General) ──────────────────────────────────────────────────────────
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# ─── AWS SES (Phase 3 — Emails) ──────────────────────────────────────────────
SES_FROM_EMAIL="hello@jkcurryhouse.co.uk"

# ─── Stripe (Phase 4 — Payments) ─────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── AWS S3 (Phase 6 — Menu Images) ──────────────────────────────────────────
# 1. Create an S3 bucket: jk-curryhouse-menu-images (eu-west-2)
# 2. Bucket policy: allow public read on objects
# 3. CORS: allow PUT/GET from your domain
# 4. IAM user needs: s3:PutObject, s3:DeleteObject, s3:GetObject on the bucket
S3_BUCKET_NAME="jk-curryhouse-menu-images"

# ─── Admin Setup (Cognito Group) ─────────────────────────────────────────────
# No extra env vars needed — admin status is read from the Cognito ID token.
# Steps to make a user an admin:
#   1. AWS Console → Cognito → User Pools → [your pool] → Users
#   2. Find the user → Add to group → Admins
#   They will see the Admin Panel in the navbar on next sign-in.

# Public site URL (used for SEO metadata and email logo links)
NEXT_PUBLIC_SITE_URL="https://www.jkcurryhouse.co.uk"
