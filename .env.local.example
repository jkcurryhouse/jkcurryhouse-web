# ─── Database: AWS RDS PostgreSQL ────────────────────────────────────────────
# Created by infra/rds-postgres.yaml — see docs/DATABASE_SETUP.md.
# Keep sslmode=require. connection_limit keeps serverless instances from exhausting RDS connections.
DATABASE_URL="postgresql://jkadmin:PASSWORD@jk-curryhouse-db.xxxxxxxx.ap-southeast-2.rds.amazonaws.com:5432/jkcurryhouse?sslmode=require&connection_limit=5"

# ─── AWS Cognito (sign-in + admin access) ────────────────────────────────────
# Admins = users in the Cognito group named exactly "Admins".
# The server verifies every admin API call's token against this pool.
NEXT_PUBLIC_COGNITO_USER_POOL_ID="ap-southeast-2_XXXXXXXXX"
NEXT_PUBLIC_COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── AWS credentials for S3 (dish photos) + SES (emails) ─────────────────────
# Locally you can use AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# In AWS Amplify you MUST use the APP_ prefix — Amplify rejects variables starting with "AWS_".
APP_AWS_REGION="ap-southeast-2"
APP_AWS_ACCESS_KEY_ID="AKIA..."
APP_AWS_SECRET_ACCESS_KEY="..."

# ─── S3 bucket for dish photos ───────────────────────────────────────────────
S3_BUCKET_NAME="jk-curryhouse-menu-images"

# ─── SES (booking/order confirmations, offer emails, staff notifications) ───
SES_FROM_EMAIL="hello@jkcurryhouse.co.uk"

# ─── Offer emails: secret for signed unsubscribe links ──────────────────────
# Any long random string, e.g. output of: openssl rand -base64 32
UNSUBSCRIBE_SECRET=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Webhook endpoint: https://www.jkcurryhouse.co.uk/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.canceled

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://www.jkcurryhouse.co.uk"
