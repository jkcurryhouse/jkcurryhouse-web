generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" is the runtime used by AWS Amplify Hosting compute / Lambda (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Menu ────────────────────────────────────────────────────────────────────

model MenuItem {
  id           String      @id @default(cuid())
  name         String
  description  String
  price        Float
  category     Category
  isSpecial    Boolean     @default(false)
  isAvailable  Boolean     @default(true)
  isVegan      Boolean     @default(false)
  isVegetarian Boolean     @default(false)
  isSpicy      Boolean     @default(false)
  chefPick     Boolean     @default(false)
  sortOrder    Int         @default(0)
  allergens    String[]    @default([])
  imageUrl     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  OrderItems   OrderItem[]

  @@index([category, isAvailable])
}

enum Category {
  STARTER
  MAIN
  SIDE
  RICE
  BREAD
  SPECIAL
}

// ─── Reservations ────────────────────────────────────────────────────────────

model Reservation {
  id             String            @id @default(cuid())
  name           String
  email          String
  phone          String
  date           DateTime
  time           String
  partySize      Int
  specialRequest String?
  status         ReservationStatus @default(PENDING)
  source         BookingSource     @default(ONLINE)
  tableNumber    String?
  adminNotes     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([date, time])
  @@index([status])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum BookingSource {
  ONLINE
  PHONE
  WALK_IN
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                    String      @id @default(cuid())
  type                  OrderType
  status                OrderStatus @default(PENDING)
  subtotal              Float       @default(0)
  deliveryFee           Float       @default(0)
  discount              Float       @default(0)
  discountCode          String?
  total                 Float
  userId                String?
  customerName          String?
  customerPhone         String?
  guestEmail            String?
  address               String?
  stripePaymentIntentId String?     @unique
  confirmationSentAt    DateTime?
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

enum OrderType {
  DELIVERY
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  name       String   @default("")
  quantity   Int
  price      Float
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

// ─── Offers ──────────────────────────────────────────────────────────────────

model Offer {
  id              String      @id @default(cuid())
  title           String
  description     String
  code            String      @unique
  discount        Float
  isPercent       Boolean     @default(true)
  isGeneral       Boolean     @default(true)
  isActive        Boolean     @default(true)
  minOrders       Int         @default(0)
  minSpend        Float       @default(0)
  minOrderValue   Float       @default(0)
  maxRedemptions  Int?
  redemptionCount Int         @default(0)
  startsAt        DateTime    @default(now())
  expiresAt       DateTime
  lastRolledOutAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  UserOffers      UserOffer[]
}

model UserOffer {
  id         String    @id @default(cuid())
  userId     String
  offerId    String
  email      String?
  notifiedAt DateTime?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
  offer      Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
}

// ─── Restaurant settings (single row, id = "default") ───────────────────────

model Settings {
  id                    String   @id @default("default")
  acceptingOrders       Boolean  @default(true)
  acceptingReservations Boolean  @default(true)
  deliveryEnabled       Boolean  @default(true)
  deliveryFee           Float    @default(2.99)
  freeDeliveryThreshold Float    @default(25)
  minDeliveryOrder      Float    @default(0)
  deliveryPostcodes     String[] @default(["SN15", "SN14"])
  maxBookingsPerSlot    Int      @default(3)
  maxCoversPerSlot      Int      @default(20)
  maxPartySize          Int      @default(12)
  closedDates           String[] @default([])
  noticeBanner          String?
  updatedAt             DateTime @updatedAt
}

// ─── Admin audit trail ───────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ─── Marketing opt-outs (GDPR / PECR) ────────────────────────────────────────

model EmailOptOut {
  email     String   @id
  createdAt DateTime @default(now())
}
